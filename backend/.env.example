# Environment variables for HeartSense Backend

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
SUPABASE_URL=https://auqhuozialxppjnpuioa.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Supabase Database Connection (PostgreSQL)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Get this from Supabase Dashboard > Project Settings > Database > Connection String
SUPABASE_DB_URL=postgresql://postgres:62110lol@db.auqhuozialxppjnpuioa.supabase.co:5432/postgres

# JWT Secret Key (for authentication tokens)
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this_in_production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
